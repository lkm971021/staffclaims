# ============================================================================
# Staff Claims - environment configuration (copy to .env and fill in).
# NEVER commit the real .env. Secrets live only in your hosting provider.
# ============================================================================

# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/claims"
# Public URL of the app, no trailing slash (used for login + Google redirects)
NEXTAUTH_URL="https://claims.example.com"
APP_URL="https://claims.example.com"
# Random secrets: generate with  openssl rand -base64 48
NEXTAUTH_SECRET=""
TOKEN_ENCRYPTION_KEY=""
# Private file storage (must be a PERSISTENT volume in production)
STORAGE_DIR="/data/storage"

# --- Google sign-in for staff (optional; email+password always available) --
GOOGLE_LOGIN_CLIENT_ID=""
GOOGLE_LOGIN_CLIENT_SECRET=""

# --- Google Drive + Sheets integration (Finance account, drive.file scope) --
# Can be the same OAuth client as sign-in; add both redirect URIs (see docs/GOOGLE_SETUP.md)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Receipt OCR (Claude vision) - optional ---------------------------------
ANTHROPIC_API_KEY=""
# OCR_MODEL="claude-opus-5-5"     # default
# OCR_EFFORT="low"                # low | medium | high

# --- Email notifications (optional; in-app notifications always work) ------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Staff Claims <claims@example.com>"

# --- Background jobs -------------------------------------------------------
# If you cannot run `npm run worker` as a second process, call POST /api/cron
# every 1-5 minutes with header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
WORKER_INTERVAL_MS="5000"

# --- Optional: Chinese characters in generated PDFs ------------------------
# Path to a single-font .ttf/.otf such as NotoSansSC-Regular.otf
PDF_CJK_FONT=""
