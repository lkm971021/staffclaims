{
  "name": "staff-claims",
  "version": "0.1.0",
  "private": true,
  "description": "Staff Expense Claim Management System - Plan B Physio",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx --env-file-if-exists=.env --conditions=react-server src/worker/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "archiver": "8.0.0",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "googleapis": "190.0.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "nodemailer": "7.0.9",
    "pdf-lib": "1.17.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
